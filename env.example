
# Local mode: set to true to run with no sign-in and no cloud services.
# The form and uploads are kept in .local-data/ in this project, and none of
# the Supabase, Azure, Resend or admin settings below are needed.
# Only for your own machine: anyone who can reach the server can edit the form.
NEXT_PUBLIC_LOCAL_MODE=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Azure Blob Storage (file storage)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=activity-evidence

# Email Verification
NEXT_PUBLIC_RESEND_API_KEY=
NEXT_PUBLIC_RESEND_DOMAIN=

# App
NEXT_PUBLIC_APP_NAME="AICTE Activity Points"
NEXT_PUBLIC_APP_ICON='/rvce-logo.png'





# Admin dashboard (comma-separated emails allowed to view /dashboard)
ADMIN_EMAILS=
